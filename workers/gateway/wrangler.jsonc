{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ironplate-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ironplate",
			// The id printed by `npx wrangler d1 create ironplate`. Not a secret, but specific to your account.
			"database_id": "59eedb50-c5e2-41b8-9697-2a17ecd75271",
			// Migrations are generated by drizzle-kit into ../../drizzle and applied with wrangler.
			"migrations_dir": "../../drizzle"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	}
}